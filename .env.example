# Required by the current backend configuration.
APP_ENV=development

# MiniMax uses an OpenAI-compatible Chat Completions endpoint. Leave secrets out of version control.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
DATABASE_URL=mysql+pymysql://readonly_user:readonly-password@mysql:3306/analytics
ALLOWED_TABLES=sales_channel_monthly
MAX_QUERY_ROWS=1000
QUERY_TIMEOUT_SECONDS=15
MAX_TOOL_CALLS=12
MAX_SQL_RETRIES=2
OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=false
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
