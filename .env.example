# Required by the current backend configuration.
APP_ENV=development

# Reserved for later MVP tasks. Leave secrets out of version control.
OPENAI_API_KEY=
OPENAI_MODEL=
DATABASE_URL=mysql+pymysql://readonly_user:readonly-password@mysql:3306/analytics
ALLOWED_TABLES=
MAX_QUERY_ROWS=1000
QUERY_TIMEOUT_SECONDS=15
MAX_TOOL_CALLS=12
MAX_SQL_RETRIES=2
OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=false
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
