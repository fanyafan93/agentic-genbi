# Agentic GenBI local runtime example.
# Copy this file to .env and fill real values locally. Do not commit .env.

# Frontend -> backend API
NEXT_PUBLIC_GENBI_API_BASE_URL=http://localhost:8000

# Auth.js / Feishu SSO
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUST_HOST=true
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Feishu app callback URL should include:
# http://localhost:3000/api/auth/callback/feishu

# Auth.js DB session storage
AUTH_DATABASE_URL=postgresql://agentic_genbi:agentic_genbi_dev_password@localhost:5432/agentic_genbi?schema=public
AUTH_POSTGRES_DB=agentic_genbi
AUTH_POSTGRES_USER=agentic_genbi
AUTH_POSTGRES_PASSWORD=agentic_genbi_dev_password

# Resource library
GENBI_FINEREPORT_ROOT=资源库/finereport/解析

# Analysis runtime
GENBI_ANALYSIS_RUNTIME=local
# GENBI_ANALYSIS_RUNTIME=codex
# GENBI_ANALYSIS_RUNTIME=llm
GENBI_LLM_PROVIDER=openai
GENBI_ANALYSIS_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# OPENAI_BASE_URL=

# MiniMax via OpenAI-compatible endpoint
# GENBI_LLM_PROVIDER=minimax
# GENBI_ANALYSIS_MODEL=
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=
# Optional generic aliases for OpenAI-compatible providers:
# GENBI_LLM_API_KEY=
# GENBI_LLM_BASE_URL=

# MySQL readonly access
GENBI_DB_HOST=127.0.0.1
GENBI_DB_PORT=3306
GENBI_DB_USER=readonly_user
GENBI_DB_PASSWORD=
GENBI_DB_DATABASE=dm
GENBI_BUSINESS_QUERY_ENABLED=true
GENBI_DB_MAX_ROWS=1000
GENBI_DB_TIMEOUT_SECONDS=30
GENBI_DB_ALLOW_SELECT_STAR=false

# Optional model cost estimate
GENBI_MODEL_INPUT_USD_PER_1M=
GENBI_MODEL_OUTPUT_USD_PER_1M=

# Optional: override the bundled openai-codex-cli-bin with a system-installed Codex binary.
# Useful when the SDK is pinned to an older release but you want a newer CLI.
# GENBI_CODEX_BIN=/usr/local/bin/codex

# Optional: render provider + MCP config into $GENBI_CODEX_HOME/config.toml and pass
# CODEX_HOME to the Codex CLI subprocess. This bypasses SDK config_overrides injection
# when the Codex version ignores it.
# GENBI_CODEX_HOME=/tmp/codex-home

# Codex MCP servers (injected into CodexConfig.config_overrides).
# Each MCP server uses 5 GENBI_CODEX_MCP_<N>_* lines:
#   GENBI_CODEX_MCP_<N>_NAME       : MCP server display name (e.g. BI_doris).
#   GENBI_CODEX_MCP_<N>_COMMAND    : Executable to launch (e.g. npx, node, python).
#   GENBI_CODEX_MCP_<N>_ARGS       : Space-separated CLI args for the command.
#   GENBI_CODEX_MCP_<N>_ENV_KEYS   : Space-separated env var names passed to the MCP server.
#   GENBI_CODEX_MCP_<N>_ENV_VALUES : Space-separated values matching ENV_KEYS order.
# N must be in [1, GENBI_CODEX_MCP_COUNT].
# Values containing commas must not be used in *_ARGS / *_ENV_VALUES (use one value per token).
# GENBI_CODEX_MCP_COUNT=1
# GENBI_CODEX_MCP_1_NAME=BI_doris
# GENBI_CODEX_MCP_1_COMMAND=npx
# GENBI_CODEX_MCP_1_ARGS=-y @benborla29/mcp-server-mysql
# GENBI_CODEX_MCP_1_ENV_KEYS=MYSQL_HOST MYSQL_PORT MYSQL_USER MYSQL_PASS ALLOW_DELETE_OPERATION ALLOW_INSERT_OPERATION ALLOW_UPDATE_OPERATION
# GENBI_CODEX_MCP_1_ENV_VALUES=8.134.63.30 9030 readonly_user replace-with-password false false false
